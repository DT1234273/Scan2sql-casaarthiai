# ============================================================================
# LedgerSutra — Environment Configuration (.env.example)
# Copy this file to .env and configure your keys.
# ============================================================================

# 1. Canonical Public Site URL (Used for canonical redirects, og:url, sitemap)
PUBLIC_SITE_URL="https://www.ledgersutra.in"
VITE_PUBLIC_SITE_URL="https://www.ledgersutra.in"

# 2. Server-Side Gemini Vision API Key (Used for OCR & Structured Invoice Extraction)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 3. Firebase Client Configuration (Firestore & Google Authentication)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# 4. Optional Pluggable Live GSTIN Verification Service (Part 5.3)
# When both are set, enables the "Verify GSTIN Status" button in the workspace.
# When omitted, the UI hides the button and shows an informational message.
GST_VERIFY_API_URL=""
GST_VERIFY_API_KEY=""

# 5. Optional Analytics & Google Search Console Verification (Part 8.7)
VITE_GA_MEASUREMENT_ID=""
VITE_GSC_VERIFICATION=""
