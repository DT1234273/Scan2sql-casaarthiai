# ============================================================================
# Scan2SQL — Local Windows Environment Configuration (.env.example)
# Copy this file to .env on your local Windows machine and update values.
# ============================================================================

# 1. PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg2://postgres:your_postgres_password@localhost:5432/scan2sql_db"

# 2. FastAPI Server Settings
APP_NAME="Scan2SQL"
APP_ENV="development"
APP_HOST="127.0.0.1"
APP_PORT="8000"
DEBUG="True"

# 3. File Upload & Storage Settings
UPLOAD_DIR="uploads"
EXPORT_DIR="exports"
MAX_UPLOAD_SIZE_MB="25"

# 4. Tesseract OCR Configuration (Windows Local Path)
# Default Windows installer path for UB-Mannheim Tesseract OCR:
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
DEFAULT_OCR_LANG="eng+hin"

# 5. Optional Local AI via Ollama (For Hybrid Bill Extraction in Phase 3)
# Set USE_OLLAMA="False" to run purely on Python regex/rule extraction.
USE_OLLAMA="False"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# ============================================================================
# AI Studio Runtime Variables (Kept for preview compatibility)
# ============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
