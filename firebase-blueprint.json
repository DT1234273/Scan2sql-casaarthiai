{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user's account profile, Tally settings, and workspace preferences in LedgerSutra.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID."
        },
        "email": {
          "type": "string",
          "description": "Verified Google account email address."
        },
        "displayName": {
          "type": "string",
          "description": "User's display name from Google account."
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL from Google account."
        },
        "userMode": {
          "type": "string",
          "enum": ["normal_user", "ca_mode"],
          "description": "Preferred workspace mode (normal_user or ca_mode)."
        },
        "firmRole": {
          "type": "string",
          "enum": ["owner", "reviewer", "staff"],
          "description": "Active role within the CA firm workspace."
        },
        "selectedColumnsJson": {
          "type": "string",
          "description": "JSON-serialized string array of active spreadsheet column keys."
        },
        "tallySettingsJson": {
          "type": "string",
          "description": "JSON-serialized TallySettings object."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when preferences were last updated."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "userMode",
        "firmRole",
        "selectedColumnsJson",
        "tallySettingsJson",
        "updatedAt"
      ]
    },
    "ClientProfile": {
      "title": "ClientProfile",
      "description": "CA firm client profile under /users/{userId}/clients/{clientId}.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique client identifier matching document ID."
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the CA firm owner."
        },
        "name": {
          "type": "string",
          "description": "Legal or trade name of the client."
        },
        "gstin": {
          "type": "string",
          "description": "15-character client GSTIN if registered."
        },
        "pan": {
          "type": "string",
          "description": "10-character client PAN."
        },
        "financialYear": {
          "type": "string",
          "description": "Active financial year (e.g. 2026-27)."
        },
        "notes": {
          "type": "string",
          "description": "Audit or filing notes for the client."
        },
        "archived": {
          "type": "boolean",
          "description": "Whether the client workspace is archived."
        },
        "createdAt": {
          "type": "string",
          "description": "Formatted creation timestamp string."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last update."
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "gstin",
        "pan",
        "financialYear",
        "notes",
        "archived",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserBill": {
      "title": "UserBill",
      "description": "Extracted invoice or bill record saved under a client workspace.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique bill record identifier matching document ID."
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the user who owns this bill record."
        },
        "clientId": {
          "type": "string",
          "description": "Client workspace ID."
        },
        "approvalStatus": {
          "type": "string",
          "enum": ["draft", "pending_review", "approved", "rejected"],
          "description": "Workflow approval status of the bill."
        },
        "fileName": {
          "type": "string",
          "description": "Original uploaded PDF or image file name."
        },
        "shopName": {
          "type": "string",
          "description": "Supplier, vendor, or shop name."
        },
        "sellerGstin": {
          "type": "string",
          "description": "15-character supplier GSTIN if present."
        },
        "buyerName": {
          "type": "string",
          "description": "Buyer or client name if present."
        },
        "buyerGstin": {
          "type": "string",
          "description": "15-character buyer GSTIN if present."
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Invoice or receipt number."
        },
        "billDate": {
          "type": "string",
          "description": "Invoice date string (YYYY-MM-DD)."
        },
        "placeOfSupply": {
          "type": "string",
          "description": "Place of supply / GST state."
        },
        "voucherType": {
          "type": "string",
          "description": "Accounting voucher category (e.g. Tax Invoice)."
        },
        "paymentMode": {
          "type": "string",
          "description": "Payment mode (e.g. Cash / UPI, Card, NEFT)."
        },
        "subtotal": {
          "type": "number",
          "description": "Net taxable value before tax."
        },
        "cgstAmount": {
          "type": "number",
          "description": "CGST tax amount."
        },
        "sgstAmount": {
          "type": "number",
          "description": "SGST tax amount."
        },
        "igstAmount": {
          "type": "number",
          "description": "IGST tax amount."
        },
        "taxAmount": {
          "type": "number",
          "description": "Total tax / GST amount."
        },
        "discountAmount": {
          "type": "number",
          "description": "Total discount amount."
        },
        "grandTotal": {
          "type": "number",
          "description": "Final grand total payable amount."
        },
        "confidence": {
          "type": "number",
          "description": "OCR extraction confidence score (0-100)."
        },
        "rawText": {
          "type": "string",
          "description": "Exact verbatim extracted OCR text."
        },
        "createdAt": {
          "type": "string",
          "description": "Formatted creation timestamp string."
        },
        "extraHeaderFieldsJson": {
          "type": "string",
          "description": "JSON-serialized Record<string, string> of custom dynamic header fields and audit trail."
        },
        "itemsJson": {
          "type": "string",
          "description": "JSON-serialized array of NoSQLBillItem line items."
        },
        "syncedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last cloud sync."
        }
      },
      "required": [
        "id",
        "ownerId",
        "clientId",
        "approvalStatus",
        "fileName",
        "shopName",
        "sellerGstin",
        "buyerName",
        "buyerGstin",
        "invoiceNumber",
        "billDate",
        "placeOfSupply",
        "voucherType",
        "paymentMode",
        "subtotal",
        "cgstAmount",
        "sgstAmount",
        "igstAmount",
        "taxAmount",
        "discountAmount",
        "grandTotal",
        "confidence",
        "rawText",
        "createdAt",
        "extraHeaderFieldsJson",
        "itemsJson",
        "syncedAt"
      ]
    },
    "UserDocument": {
      "title": "UserDocument",
      "description": "Verbatim OCR text document saved under a client workspace.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique document record identifier matching document ID."
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the user who owns this document record."
        },
        "clientId": {
          "type": "string",
          "description": "Client workspace ID."
        },
        "fileName": {
          "type": "string",
          "description": "Original uploaded file name."
        },
        "fileType": {
          "type": "string",
          "description": "File extension/type (PDF, JPG, PNG)."
        },
        "docType": {
          "type": "string",
          "enum": ["NORMAL_DOCUMENT", "SHOP_BILL"],
          "description": "Detected document classification."
        },
        "pageCount": {
          "type": "integer",
          "description": "Number of pages processed."
        },
        "ocrLanguage": {
          "type": "string",
          "description": "OCR language code used (e.g. eng+hin)."
        },
        "extractedText": {
          "type": "string",
          "description": "Verbatim extracted text from the document."
        },
        "confidence": {
          "type": "number",
          "description": "OCR confidence score (0-100)."
        },
        "createdAt": {
          "type": "string",
          "description": "Formatted creation timestamp string."
        },
        "syncedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last cloud sync."
        }
      },
      "required": [
        "id",
        "ownerId",
        "clientId",
        "fileName",
        "fileType",
        "docType",
        "pageCount",
        "ocrLanguage",
        "extractedText",
        "confidence",
        "createdAt",
        "syncedAt"
      ]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "CA firm team member and role assignment.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Team member record ID."
        },
        "ownerId": {
          "type": "string",
          "description": "Firm owner UID."
        },
        "email": {
          "type": "string",
          "description": "Team member Google email."
        },
        "name": {
          "type": "string",
          "description": "Display name."
        },
        "role": {
          "type": "string",
          "enum": ["owner", "reviewer", "staff"],
          "description": "Assigned role."
        },
        "assignedClientsJson": {
          "type": "string",
          "description": "JSON array of clientIds assigned to this member."
        },
        "status": {
          "type": "string",
          "enum": ["active", "invited"],
          "description": "Invitation status."
        },
        "invitedAt": {
          "type": "string",
          "description": "Formatted invitation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "email",
        "name",
        "role",
        "assignedClientsJson",
        "status",
        "invitedAt",
        "updatedAt"
      ]
    },
    "UserApiKey": {
      "title": "UserApiKey",
      "description": "Hashed API key for programmatic /api/v1/extract access.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "API key record ID."
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID."
        },
        "label": {
          "type": "string",
          "description": "Key description label."
        },
        "keyPrefix": {
          "type": "string",
          "description": "Visible prefix of the key."
        },
        "keyHash": {
          "type": "string",
          "description": "SHA-256 hex digest of the secret key."
        },
        "revoked": {
          "type": "boolean",
          "description": "Whether the key has been revoked."
        },
        "createdAt": {
          "type": "string",
          "description": "Formatted creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "label",
        "keyPrefix",
        "keyHash",
        "revoked",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores per-user profile, Tally settings, and workspace preferences."
    },
    "/users/{userId}/clients/{clientId}": {
      "schema": {
        "$ref": "#/entities/ClientProfile"
      },
      "description": "Stores CA firm client profiles."
    },
    "/users/{userId}/clients/{clientId}/bills/{billId}": {
      "schema": {
        "$ref": "#/entities/UserBill"
      },
      "description": "Stores client-scoped extracted invoices and bills."
    },
    "/users/{userId}/clients/{clientId}/documents/{docId}": {
      "schema": {
        "$ref": "#/entities/UserDocument"
      },
      "description": "Stores client-scoped verbatim OCR documents."
    },
    "/users/{userId}/teamMembers/{memberId}": {
      "schema": {
        "$ref": "#/entities/TeamMember"
      },
      "description": "Stores CA firm team members and role assignments."
    },
    "/users/{userId}/apiKeys/{keyId}": {
      "schema": {
        "$ref": "#/entities/UserApiKey"
      },
      "description": "Stores SHA-256 hashed API keys for /api/v1/extract."
    }
  }
}
